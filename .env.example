PROCORE_CLIENT_ID=your-sandbox-client-id
PROCORE_CLIENT_SECRET=your-sandbox-client-secret
PROCORE_AUTH_URL=https://login-sandbox.procore.com
PROCORE_API_URL=https://sandbox.procore.com
PROCORE_OAUTH_MODE=out_of_band
PROCORE_REDIRECT_URI_OOB=urn:ietf:wg:oauth:2.0:oob
# Optional locally (a random one is generated each start). Set a fixed random value when you host the app.
# SESSION_SECRET=
# Bonus webhook exercise (optional): a long random string. Procore must send it as "Authorization: Bearer <this value>".
# WEBHOOK_SECRET=
